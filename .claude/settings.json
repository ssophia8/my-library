{
  "permissions": {
    "deny": [
      "Read(/literatures/*.*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Write|Edit|NotebookEdit|Grep|Glob|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "[ -f \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-literatures.py\" ] && python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-literatures.py\" || true",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
